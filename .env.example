# Copie para .env e ajuste. O .env nunca vai para o Git.

# Chave que assina os tokens de login. Gere uma com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

# Banco de dados. Sem esta linha, usa o SQLite gymduel.db na raiz do projeto.
# Em produção, use a URL do PostgreSQL (postgres://... é aceito).
# DATABASE_URL=sqlite:///./gymduel.db

# Quantas pessoas podem se cadastrar (o app é para a dupla).
MAX_USERS=2

# Quantos treinos pontuam por dia, por pessoa (regra anti-trapaça).
MAX_WORKOUTS_PER_DAY=1

# Duração do login, em dias.
JWT_EXPIRE_DAYS=30

# SÓ PARA DESENVOLVIMENTO: finge que hoje é esta data (AAAA-MM-DD).
# Útil para demonstrações e screenshots. Nunca defina em produção.
# APP_TODAY=2026-10-15
